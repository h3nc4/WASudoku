# The cache policy nginx.conf used to carry, now that the edge serves these.
# Vite copies this file into dist, where Cloudflare reads it and does not serve it.

# The security set is named here rather than left to the zone rule in
# h3nc4-infra, which measuring the apex on 2026-09-29 showed is not live.

# frame-ancestors rather than X-Frame-Options, because the portfolio embeds this
# in a DeviceFrame and SAMEORIGIN broke that preview on 2026-09-29.
/
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff
  Content-Security-Policy: frame-ancestors 'self' https://h3nc4.com https://www.h3nc4.com
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff
  Content-Security-Policy: frame-ancestors 'self' https://h3nc4.com https://www.h3nc4.com
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Unhashed, so a cached copy would hold back every later deploy.
/sw.js
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000

# Vite fingerprints everything under here, so a name never changes meaning.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000
