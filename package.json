{
  "name": "wasudoku",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "predev": "npm run wasm:build:dev",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "prebuild": "npm run wasm:build:prod",
    "build": "tsc -b && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:preview": "PREVIEW=1 ASTRO_TELEMETRY_DISABLED=1 astro build",
    "budget": "sh scripts/budget.sh --enforce dist",
    "check:astro": "ASTRO_TELEMETRY_DISABLED=1 astro check --tsconfig tsconfig.astro.json --minimumFailingSeverity hint",
    "lint": "eslint --max-warnings 0 .",
    "lint:md": "rumdl check README.md",
    "lint:sh": "shellcheck -o all scripts/*.sh",
    "lint:type": "sh scripts/lint-type.sh",
    "lint:wasm": "cd src/wasudoku-wasm && cargo clippy --all-targets -- -D warnings",
    "typecheck": "tsc -b",
    "format:check": "prettier --check .",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test:wasm": "cd src/wasudoku-wasm && cargo llvm-cov --fail-under-lines 100 --fail-under-functions 100 --cobertura --output-path ../../coverage-wasm.xml",
    "test:unit": "vitest run --coverage; s=$?; mv coverage/lcov.info coverage-ui.lcov; rm -rf coverage; exit $s",
    "test:browser": "vitest --config vitest.config.browser.ts",
    "test:e2e": "playwright test",
    "pretest": "npm run wasm:build:dev",
    "test": "rm -f coverage-*; npm run test:wasm && npm run test:unit",
    "audit": "npm audit --audit-level=high",
    "audit:wasm": "cd src/wasudoku-wasm && cargo audit",
    "wasm:build:dev": "sh scripts/wasm-build.sh dev",
    "wasm:build:prod": "sh scripts/wasm-build.sh release"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.7",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "alien-signals": "3.2.1",
    "astro": "7.4.13",
    "eslint": "10.15.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jest-dom": "5.11.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-testing-library": "7.16.3",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.2",
    "playwright": "1.64.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rumdl": "0.3.6",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "playwright-core": "$playwright"
  }
}
