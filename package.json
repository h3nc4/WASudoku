{
  "name": "wasudoku",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "predev": "npm run wasm:build:dev",
    "dev": "vite",
    "prebuild": "npm run wasm:build:prod",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:md": "rumdl check README.md",
    "lint:sh": "shellcheck -o all scripts/*.sh",
    "lint:wasm": "cd src/wasudoku-wasm && cargo clippy --all-targets -- -D warnings",
    "typecheck": "tsc -b",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test:wasm": "cd src/wasudoku-wasm && cargo llvm-cov --cobertura --output-path ../../coverage-wasm.xml",
    "test:ui": "vitest run --coverage; s=$?; mv coverage/lcov.info coverage-ui.lcov; rm -rf coverage; exit $s",
    "test:browser": "vitest --config vitest.config.browser.ts",
    "test:e2e": "playwright test",
    "pretest": "npm run wasm:build:dev",
    "test": "rm -f coverage-*; npm run test:wasm && npm run test:ui",
    "audit": "npm audit --audit-level=high",
    "audit:wasm": "cd src/wasudoku-wasm && cargo audit",
    "wasm:build:dev": "wasm-pack build src/wasudoku-wasm --target web --dev",
    "wasm:build:prod": "wasm-pack build src/wasudoku-wasm --target web --release -- --no-default-features"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/recursive": "5.3.0",
    "@playwright/test": "1.64.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "lucide-react": "1.63.0",
    "next-themes": "0.4.6",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "rumdl": "0.3.2",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
