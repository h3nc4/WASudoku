{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "reviewers": ["h3nc4"],
  "assignAutomerge": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "lockFileMaintenance": {
    "enabled": true,
    "addLabels": ["automerge"],
    "automerge": true,
    "schedule": ["before 4am"]
  },
  "vulnerabilityAlerts": {
    "description": "Deliberately unscheduled: advisory fixes should not wait for the nightly window",
    "enabled": true,
    "addLabels": ["automerge", "security"],
    "automerge": true,
    "platformAutomerge": true,
    "rebaseWhen": "behind-base-branch"
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "The dev container pin belongs to CI, not to Renovate.",
      "matchManagers": ["devcontainer"],
      "enabled": false
    },
    {
      "groupName": "vite-ecosystem",
      "matchPackageNames": [
        "/^vite/",
        "/^vitest/",
        "/^@vitejs/",
        "/^@vitest/",
        "/^playwright/",
        "/^@playwright/"
      ]
    },
    {
      "description": "Playwright 1.65 installs Firefox build 1572, which crashes the page once two script worlds read ariaLabelledByElements, as https://github.com/microsoft/playwright/issues/43967 reports. Build 1578 in 1.66 fixes it.",
      "matchPackageNames": ["playwright", "playwright-core", "@playwright/test"],
      "allowedVersions": "!/^1\\.65\\./"
    },
    {
      "groupName": "eslint",
      "matchPackageNames": [
        "/^eslint/",
        "/^@eslint/",
        "/^typescript-eslint/",
        "/^@typescript-eslint/"
      ]
    },
    {
      "groupName": "tailwind",
      "matchPackageNames": ["/^tailwindcss/", "/^@tailwindcss/", "/^prettier-plugin-tailwindcss/"]
    },
    {
      "matchManagers": ["cargo"],
      "groupName": "rand",
      "matchPackageNames": ["/^rand/"]
    },
    {
      "description": "Group SonarQube server and scanner updates",
      "groupName": "sonarqube",
      "matchPackageNames": ["sonarqube", "sonarsource/sonar-scanner-cli"]
    },
    {
      "description": "Disable unwanted pinning for Bubblewrap",
      "matchPackageNames": ["ghcr.io/googlechromelabs/bubblewrap"],
      "pinDigests": false
    },
    {
      "description": "Disable unwanted pinning for SonarQube images",
      "matchPackageNames": ["sonarqube", "sonarsource/sonar-scanner-cli"],
      "pinDigests": false
    },
    {
      "description": "Auto-merge all minor, patch, pin, and digest updates",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "addLabels": ["automerge"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Majors never automerge, so rebase them only on a conflict rather than rerunning CI each time main moves",
      "matchUpdateTypes": ["major"],
      "rebaseWhen": "conflicted"
    }
  ],
  "customManagers": [
    {
      "description": "Update Rust version in CI/Dev Dockerfiles",
      "customType": "regex",
      "managerFilePatterns": ["/^docker/ci\\.Dockerfile$/", "/^docker/dev\\.Dockerfile$/"],
      "matchStrings": ["ARG RUST_VERSION=\"(?<currentValue>.*?)\""],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "rust-lang/rust"
    },
    {
      "description": "Update Node version in CI/Dev Dockerfiles",
      "customType": "regex",
      "managerFilePatterns": ["/^docker/ci\\.Dockerfile$/", "/^docker/dev\\.Dockerfile$/"],
      "matchStrings": ["ARG NODE_VERSION=\"(?<currentValue>.*?)\""],
      "datasourceTemplate": "node-version",
      "depNameTemplate": "node"
    },
    {
      "description": "Update Bubblewrap version in build script",
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/build-apk\\.sh$/"],
      "matchStrings": ["bubblewrap_version=\"(?<currentValue>.*?)\""],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/googlechromelabs/bubblewrap"
    },
    {
      "description": "Update Cargo packages in wasm-deps script",
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/wasm-deps\\.sh$/"],
      "matchStrings": ["(?<depName>[a-z0-9-_]+) (?<currentValue>[^\\s]+)"],
      "datasourceTemplate": "crate"
    },
    {
      "description": "Update the Python image the font subset is built in",
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/font-subset\\.sh$/"],
      "matchStrings": [
        "\\b(?<depName>python):(?<currentValue>[0-9][^@\\s]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
