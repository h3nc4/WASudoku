import ActionRow from './ActionRow.astro'
import Board from './Board.astro'
import ConfirmDialog from './ConfirmDialog.astro'
import ControlRow from './ControlRow.astro'
import { LAYOUT_CLASSES, SELECTING_CLASSES } from './controls'
import GameStatus from './GameStatus.astro'
import Header from './Header.astro'
import HintStrip from './HintStrip.astro'
import Icon from './Icon.astro'
import InputMode from './InputMode.astro'
import NumberPad from './NumberPad.astro'
import SelectionScreen from './SelectionScreen.astro'
import StepsPanel from './StepsPanel.astro'
import ToastRegion from './ToastRegion.astro'
import { type AppView, isReadOnly } from './view'
import WinDialog from './WinDialog.astro'

interface Props {
  view: AppView
  toasts?: readonly string[] | undefined
}

const { view, toasts } = Astro.props
const selecting = view.mode === 'selecting'
const visualizing = view.mode === 'visualizing'
---

<div class="text-foreground flex min-h-screen flex-col">
  <Header />
  {/* The one status region, outside main so it still speaks while main is inert. */}
  <p role="status" id="announcer" class="sr-only"></p>
  {/* Inert behind the selection screen. Its dimmed controls take no focus. */}
  <main
    inert={selecting}
    class:list={[
      'container mx-auto flex flex-1 flex-col items-center justify-start px-4 py-2 transition-opacity duration-200 motion-reduce:transition-none md:p-4',
      selecting && SELECTING_CLASSES,
    ]}
  >
    <div
      id="layout"
      class:list={[
        'w-full max-w-4xl gap-8',
        visualizing ? LAYOUT_CLASSES.walkthrough : LAYOUT_CLASSES.play,
      ]}
    >
      <div
        class="flex w-full max-w-md flex-col gap-(--column-gap) [--column-gap:--spacing(3)] md:order-2 md:[--column-gap:--spacing(6)]"
      >
        <GameStatus status={view.status} />
        <Board cells={view.cells} />
        <HintStrip />
        <div class="flex flex-col gap-3 md:gap-4">
          <ControlRow controls={view.controls} />
          <NumberPad cells={view.playerCells ?? view.cells} readOnly={isReadOnly(view)} />
          <InputMode mode={view.inputMode} disabled={visualizing} />
          <ActionRow view={view} />
          <div
            id="scroll-hint"
            hidden={!visualizing}
            class="text-primary mt-2 flex animate-bounce items-center justify-center motion-reduce:animate-none md:hidden"
          >
            <span class="text-sm font-medium">Scroll down for solving steps</span>
            <Icon name="chevron-down" class="ml-1 size-5" />
          </div>
        </div>
      </div>
      <StepsPanel walkthrough={view.walkthrough} />
    </div>
  </main>
  <SelectionScreen hidden={!selecting} />
  <WinDialog summary={view.winSummary ?? ''} />
  <ConfirmDialog
    id="abandon-dialog"
    title="Abandon current game?"
    description="The board in progress is replaced and cannot be restored."
    confirmLabel="Start new puzzle"
    destructive
  />
  <ConfirmDialog
    id="reveal-dialog"
    title="Reveal the solution?"
    description="Every remaining cell is filled in and the solving steps open beside the board. Exit the walkthrough to return to this game."
    confirmLabel="Reveal solution"
  />
  <ConfirmDialog
    id="pending-dialog"
    title="Start this puzzle?"
    description="A puzzle was shared with WASudoku. It is checked for a unique solution before play starts."
    confirmLabel="Start puzzle"
    cancelLabel="Not now"
  />
  <footer class="text-muted-foreground container mx-auto px-4 py-3 text-center text-xs md:p-4">
    <a
      href="https://h3nc4.com"
      target="_blank"
      rel="noopener noreferrer"
      class="hover:text-foreground inline-block transition-colors"
    >
      <p>🄯 2025-2026 Henrique Almeida.</p>
      <p>Because knowledge should be free.</p>
    </a>
  </footer>
</div>
<ToastRegion toasts={toasts} />
