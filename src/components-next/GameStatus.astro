import Button from './Button.astro'
import Icon from './Icon.astro'
import { isMistakeLimit, mistakesText, type StatusView } from './view'

interface Props {
  status: StatusView
}

const { status } = Astro.props
---

<div
  id="game-status"
  class="voice-mono text-muted-foreground bg-paper flex min-h-10 w-full items-center justify-between rounded-md px-3 text-sm tabular-nums"
>
  <div class="flex items-center gap-3">
    <span class="text-foreground" data-status="difficulty">{status.difficulty}</span>
    <span class="flex items-center gap-1.5">
      <span>Mistakes:</span>
      <span
        data-status="mistakes"
        class:list={[isMistakeLimit(status.mistakes) && 'text-error font-bold']}
        >{mistakesText(status.mistakes)}</span
      >
    </span>
  </div>
  <div class="flex items-center gap-2">
    {status.solved && <span class="text-ink font-bold">Solved</span>}
    <span class="text-foreground" data-status="time">{status.time}</span>
    {
      !status.solved && (
        <Button
          variant="ghost"
          size="icon-lg"
          class="-mr-3"
          id="pause-button"
          aria-label="Pause game"
          title="Pause game"
        >
          <Icon name="pause" />
        </Button>
      )
    }
  </div>
</div>
