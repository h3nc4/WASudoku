import Button from './Button.astro'
import { actionButtons, actionClass, newPuzzleVariant } from './controls'
import Icon from './Icon.astro'
import NewPuzzleMenu from './NewPuzzleMenu.astro'
import type { AppView } from './view'

interface Props {
  view: AppView
}

const { view } = Astro.props
---

<div class="grid w-full grid-cols-2 gap-2">
  <NewPuzzleMenu variant={newPuzzleVariant(view)} custom={view.mode !== 'selecting'} />
  {
    actionButtons(view).map((action) => (
      <Button
        variant={action.variant}
        size="lg"
        id={action.id}
        title={action.title}
        disabled={action.disabled}
        class={actionClass(action)}
      >
        <Icon name={action.icon} class="mr-2 size-4" />
        {action.label}
      </Button>
    ))
  }
</div>
