import Button from './Button.astro'
import { rowClass, stepsPanel } from './controls'
import Icon from './Icon.astro'
import { endRow, isSolution, stepTag, traceRows, type WalkthroughView } from './view'

interface Props {
  walkthrough?: WalkthroughView | undefined
}

const panel = stepsPanel(Astro.props.walkthrough)
const walkthrough = panel.view
const rows = traceRows(walkthrough)
const first = endRow(0, walkthrough)
const last = endRow(walkthrough.steps.length, walkthrough)
---

{/* Size containment lets the panel take the board column's height instead of the trace's. */}
<div
  data-toast-floor
  class="w-full [contain:size] md:order-1 md:w-64"
  id="steps-panel"
  hidden={panel.hidden}
>
  <section
    aria-labelledby="steps-title"
    class="bg-paper border-grid-thin flex h-full min-w-0 flex-col gap-2 rounded-md border p-3"
    style={panel.style}
  >
    <div class="flex items-center justify-between gap-2">
      <h2
        id="steps-title"
        class="voice-mono text-muted-foreground text-xs font-semibold tracking-[0.08em] uppercase"
      >
        Solving Steps
      </h2>
      <div class="flex items-center gap-1">
        <span class="voice-mono text-muted-foreground mr-1 text-xs tabular-nums" id="step-count"
          >{stepTag(walkthrough.current, walkthrough.steps.length)}/{walkthrough.steps.length}</span
        >
        <Button
          variant="ghost"
          size="icon-sm"
          class="size-7"
          id="previous-step"
          title="Previous step (Left arrow)"
          aria-label="Previous step"
          disabled={walkthrough.current <= 0}><Icon name="chevron-left" /></Button
        >
        <Button
          variant="ghost"
          size="icon-sm"
          class="size-7"
          id="next-step"
          title="Next step (Right arrow)"
          aria-label="Next step"
          disabled={isSolution(walkthrough)}><Icon name="chevron-right" /></Button
        >
      </div>
    </div>
    <div class="border-grid-thin flex min-h-0 flex-1 flex-col gap-1 border-t pt-2">
      {/* Screen readers join the spans on these spaces, which a grid leaves out of layout. */}
      <button
        type="button"
        id="step-start"
        class={rowClass(first.tone)}
        data-step={first.position}
        aria-current={first.current ? 'step' : undefined}
      >
        <span data-tag>{stepTag(0, walkthrough.steps.length)}</span>{' '}
        <span class="col-span-2">Initial Board State</span>
      </button>
      <ol aria-label="Solver trace" class="scroller min-h-0 flex-1" id="solver-trace">
        {
          rows.map((row) => (
            <li id={`solver-step-${String(row.position - 1)}`}>
              <button
                type="button"
                class={rowClass(row.tone)}
                data-step={row.position}
                aria-current={row.tone === 'current' ? 'step' : undefined}
              >
                <span class="sr-only">Step</span>{' '}
                <span>{row.tag}</span>{' '}
                <span class="whitespace-nowrap">{row.where}</span>{' '}
                <span class="min-w-0 break-words">{row.label}</span>
              </button>
            </li>
          ))
        }
      </ol>
      <button
        type="button"
        id="step-end"
        class={rowClass(last.tone)}
        data-step={last.position}
        aria-current={last.current ? 'step' : undefined}
      >
        <span></span>{' '}
        <span class="col-span-2">Solution</span>
      </button>
    </div>
    <p
      aria-live="polite"
      id="step-explanation"
      class="border-grid-thin text-foreground h-36 shrink-0 overflow-y-auto border-t pt-2 text-sm leading-snug"
    >
      <span data-explanation>{walkthrough.explanation}</span>
      <span
        class="voice-mono text-solver mt-2 block text-xs font-semibold"
        data-solved-in
        hidden={panel.solvedIn.hidden}>{panel.solvedIn.text}</span
      >
    </p>
  </section>
</div>
