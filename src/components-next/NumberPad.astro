import Button from './Button.astro'
import { padTones } from './controls'
import { type CellView, padKeys } from './view'

interface Props {
  cells: readonly CellView[]
  readOnly: boolean
}

const keys = padKeys(Astro.props.cells, Astro.props.readOnly)
---

<div class="grid grid-cols-9 gap-1" role="group" aria-label="On-screen number pad" id="number-pad">
  {
    keys.map((key) => (
      <Button
        variant="paper"
        size="icon"
        class="aspect-[1/1.12] h-auto min-h-11 w-full rounded-[4px]"
        aria-label={key.label}
        data-digit={key.digit}
        disabled={key.disabled}
      >
        <div class="flex size-full flex-col items-center justify-center gap-0.5 md:gap-1">
          <span
            class:list={[
              'voice-ink pad-strike text-xl leading-none md:text-2xl',
              padTones(key, false).digit,
            ]}
            data-struck={key.remaining > 0 ? undefined : ''}
          >
            {key.digit}
          </span>{' '}
          <span
            class:list={[
              'voice-mono text-2xs leading-none tabular-nums md:text-xs',
              padTones(key, false).count,
            ]}
            hidden={key.remaining <= 0}
            data-count
          >
            {key.remaining}
          </span>
        </div>
      </Button>
    ))
  }
</div>
