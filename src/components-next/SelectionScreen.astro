import Button from './Button.astro'
import DifficultyPicker from './DifficultyPicker.astro'
import Icon from './Icon.astro'
---

<div class="absolute inset-0 z-20 flex items-center justify-center p-4" id="selection-screen">
  <section
    aria-labelledby="welcome-title"
    class="bg-card text-card-foreground flex w-full max-w-xl flex-col gap-4 rounded-md border p-6 shadow-[0_24px_60px_-16px_rgb(0_0_0/0.35)] sm:p-8"
  >
    <h2 id="welcome-title" class="voice-ink text-ink text-center text-2xl tracking-tight">
      Welcome to WASudoku
    </h2>
    <p class="text-muted-foreground text-center text-sm">Pick a difficulty to start.</p>
    <DifficultyPicker />
    <Button variant="paper" size="md" id="custom-button">
      <Icon name="pen-line" class="mr-2 size-4" />
      Create Your Own
    </Button>
  </section>
</div>
