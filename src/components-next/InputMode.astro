import { INPUT_MODES } from './controls'
import type { InputMode } from './view'

interface Props {
  mode: InputMode
  disabled: boolean
}

const { mode, disabled } = Astro.props
---

{/* Native radios: one tab stop on the checked mode, and arrow keys move and check. */}
<fieldset class="seg w-full" id="input-mode" disabled={disabled}>
  <legend class="sr-only">Input mode</legend>
  {
    INPUT_MODES.map((item) => (
      <label>
        <input type="radio" name="input-mode" value={item.value} checked={item.value === mode} />
        {item.label}
      </label>
    ))
  }
</fieldset>
