import Button from './Button.astro'
import Icon from './Icon.astro'
import type { ControlsView } from './view'

interface Props {
  controls: ControlsView
}

const { undo, redo, autoFill, erase, sticky } = Astro.props.controls
---

<div class="grid w-full grid-cols-5 place-items-center gap-2" id="control-row">
  <Button
    variant="paper"
    size="icon-lg"
    id="undo-button"
    title={undo.title}
    aria-label={undo.title}
    disabled={undo.disabled}><Icon name="undo" /></Button
  >
  <Button
    variant="paper"
    size="icon-lg"
    id="redo-button"
    title={redo.title}
    aria-label={redo.title}
    disabled={redo.disabled}><Icon name="redo" /></Button
  >
  <Button
    variant="paper"
    size="icon-lg"
    id="autofill-button"
    title={autoFill.title}
    aria-label={autoFill.title}
    disabled={autoFill.disabled}><Icon name="pencil" /></Button
  >
  <Button
    variant="paper"
    size="icon-lg"
    id="erase-button"
    title={erase.title}
    aria-label={erase.title}
    disabled={erase.disabled}><Icon name="eraser" /></Button
  >
  <Button
    variant={sticky.on ? 'primary' : 'paper'}
    size="icon-lg"
    id="sticky-button"
    title="Sticky numbers"
    aria-label="Sticky numbers"
    aria-pressed={sticky.on ? 'true' : 'false'}
    disabled={sticky.disabled}><Icon name={sticky.on ? 'lock' : 'lock-open'} /></Button
  >
</div>
