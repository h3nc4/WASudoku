import Button from './Button.astro'
import type { Variant } from './controls'
import Icon from './Icon.astro'
import { DIFFICULTIES } from './view'

interface Props {
  variant: Variant
  custom: boolean
}

const { variant, custom } = Astro.props
---

<Button
  variant={variant}
  size="lg"
  id="new-button"
  class="flex-1 [anchor-name:--new-button]"
  aria-haspopup="menu"
  aria-expanded="false"
  popovertarget="new-menu"
>
  <Icon name="wand-sparkles" class="mr-2 size-4" />
  New Puzzle
</Button>
<div
  id="new-menu"
  popover="auto"
  role="menu"
  aria-labelledby="new-button"
  class="menu [position-anchor:--new-button]"
>
  {
    DIFFICULTIES.map((level) => (
      <button
        type="button"
        role="menuitem"
        tabindex="-1"
        class="menu-item"
        data-difficulty={level.toLowerCase()}
      >
        {level}
      </button>
    ))
  }
  {
    custom && (
      <>
        <div role="separator" class="bg-border -mx-1 my-1 h-px" />
        <button type="button" role="menuitem" tabindex="-1" class="menu-item" data-action="custom">
          <Icon name="pen-line" class="mr-2 size-4" />
          Custom
        </button>
      </>
    )
  }
</div>
