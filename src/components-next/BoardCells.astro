import { CELL_TESTID, type DrawnCell } from './view'

interface Props {
  rows: readonly (readonly DrawnCell[])[]
}

const { rows } = Astro.props
---

{
  rows.map((row) => (
    <div role="row">
      {row.map((cell) => (
        <div role="gridcell" class="c" data-testid={CELL_TESTID.face} {...cell.attributes}>
          {cell.wrong && (
            <svg
              class="x"
              aria-hidden="true"
              data-testid={CELL_TESTID.errorMark} viewBox="0 0 100 100" preserveAspectRatio="none">
              <path d="M10 10 90 90M90 10 10 90" />
            </svg>
          )}
          {cell.value !== undefined && (
            <span class="d" aria-hidden="true" data-testid={CELL_TESTID.digit}>
              {cell.value}
            </span>
          )}
          {cell.corner && (
            <span class="n" aria-hidden="true">
              {cell.corner.map((slot) => [' ', <span data-struck={slot.struck}>{slot.digit}</span>])}
            </span>
          )}
          {cell.center && (
            <span class="n" data-center={cell.center.size} aria-hidden="true">
              {cell.center.digits.map((digit) => [' ', <span>{digit}</span>])}
            </span>
          )}
        </div>
      ))}
    </div>
  ))
}
