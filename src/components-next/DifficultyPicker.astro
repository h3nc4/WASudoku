import Button from './Button.astro'
import { DIFFICULTIES } from './view'

interface Props {
  disabled?: boolean
  submit?: boolean
}

const { disabled = false, submit = false } = Astro.props
---

<div class="grid grid-cols-2 gap-2 sm:grid-cols-5">
  {
    DIFFICULTIES.map((level) => (
      <Button
        variant="paper"
        size="md"
        type={submit ? 'submit' : 'button'}
        value={level.toLowerCase()}
        data-difficulty={level.toLowerCase()}
        disabled={disabled}
        class:list={[level === 'Extreme' && 'col-span-2 sm:col-span-1']}
      >
        {level}
      </Button>
    ))
  }
</div>
