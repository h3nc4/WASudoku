import CloseButton from './CloseButton.astro'
import DifficultyPicker from './DifficultyPicker.astro'
import Icon from './Icon.astro'

interface Props {
  summary: string
}

const { summary } = Astro.props
---

{/* Each difficulty button closes the dialog with its level as the return value. */}
<dialog
  id="win-dialog"
  class="dlg sm:max-w-xl"
  closedby="any"
  aria-labelledby="win-title"
  aria-describedby="win-summary"
>
  <form method="dialog" class="contents">
    <div class="flex flex-col gap-2 text-center sm:text-left">
      <h2
        id="win-title"
        class="voice-ink text-ink flex items-center gap-2 text-xl leading-tight tracking-tight"
      >
        <Icon name="party-popper" class="text-ink size-5" />
        Puzzle solved
      </h2>
      <p id="win-summary" class="text-muted-foreground text-sm">{summary}</p>
    </div>
    <div class="flex flex-col gap-2">
      <p class="voice-mono text-muted-foreground text-xs tracking-wider uppercase">Play another</p>
      <DifficultyPicker submit />
    </div>
    <CloseButton />
  </form>
</dialog>
