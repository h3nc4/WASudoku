  class?: string
}

const { class: className } = Astro.props
---

{/* "WA" speaks in the solver's mono instrument voice, "Sudoku" in printed ink. */}
<span
  role="img"
  aria-label="WASudoku"
  class:list={['inline-flex items-baseline font-sans tracking-tight', className]}
  ><span aria-hidden="true" class="voice-mono text-pencil font-medium">WA</span><span
    aria-hidden="true"
    class="voice-ink text-ink">Sudoku</span
  ></span
>
