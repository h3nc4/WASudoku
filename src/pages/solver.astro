import Article from '../layouts/Article.astro'
import {
  BACKTRACKING_LINK,
  finderRows,
  LOGIC,
  ORDER,
  SEARCH,
  SOLVER_INTRO,
  SOLVER_META,
} from '../pages-data/solver'

const rows = finderRows()
---

<Article meta={SOLVER_META}>
  <h1>How the solver works</h1>
  <p class="lead">{SOLVER_INTRO}</p>

  <h2 id={LOGIC.id}>{LOGIC.heading}</h2>
  {LOGIC.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

  <h2 id={ORDER.id}>{ORDER.heading}</h2>
  {ORDER.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  <table>
    <thead>
      <tr>
        <th scope="col">Order</th>
        <th scope="col">Technique</th>
        <th scope="col">Level</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <td>{row.position}</td>
            <td>
              <a href={row.href}>{row.label}</a>
            </td>
            <td>{row.level}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <h2 id={SEARCH.id}>{SEARCH.heading}</h2>
  {SEARCH.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  <p><a href={BACKTRACKING_LINK.href}>{BACKTRACKING_LINK.label}</a> has an example board.</p>

  <p><a class="play" href="/">Open WASudoku</a></p>
</Article>
