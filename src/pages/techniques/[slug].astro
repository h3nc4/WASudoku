import BoardFigure from '../../components/BoardFigure.astro'
import Article from '../../layouts/Article.astro'
import { ALL_TECHNIQUES } from '../../pages-data/solver'
import { type TechniquePage, techniquePaths } from '../../pages-data/techniques'

export const getStaticPaths = techniquePaths

interface Props {
  page: TechniquePage
}

const { page } = Astro.props
---

<Article meta={page.meta}>
  <h1>{page.name}</h1>
  {page.level && <p class="level">{page.level} level</p>}
  {page.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

  <h2>Example from the solver</h2>
  <BoardFigure example={page.example} />
  <p><a class="play" href={page.playHref}>Play this puzzle in WASudoku</a></p>

  <nav aria-label="Techniques" class="pager">
    {
      page.previous && (
        <a href={page.previous.href} rel="prev">
          <span class="level">Previous</span> {page.previous.label}
        </a>
      )
    }
    <a href={ALL_TECHNIQUES.href}>{ALL_TECHNIQUES.label}</a>
    {
      page.next && (
        <a href={page.next.href} rel="next">
          <span class="level">Next</span> {page.next.label}
        </a>
      )
    }
  </nav>
</Article>
