import Footer from '../components/Footer.astro'
import Wordmark from '../components/Wordmark.astro'
import type { PageMeta } from '../pages-data/site'
import '../styles/article.css'
import Shell from './Shell.astro'

interface Props {
  meta: PageMeta
}

const { meta } = Astro.props
---

<Shell meta={meta} sprite={false}>
  <div class="text-foreground flex min-h-screen flex-col">
    <header class="site-header container mx-auto">
      <a href="/"><Wordmark class="text-2xl tracking-tight md:text-3xl" /></a>
    </header>
    <main class="article flex-1">
      <slot />
    </main>
    <Footer />
  </div>
</Shell>
