import fontUrl from '../assets/fonts/recursive-main.woff2?url'
import Sprite from '../components-next/Sprite.astro'
import '../styles/app.css'
import { THEME_SCRIPT } from '../ui/theme'

interface Props {
  theme?: 'light' | 'dark'
}

const { theme } = Astro.props
const description = 'A Sudoku solver that runs locally in your browser using WebAssembly.'
const site = 'https://wasudoku.h3nc4.com/'
const preview = `${site}wasudoku-preview.png`
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={THEME_SCRIPT} />
    <title>WASudoku</title>
    <meta name="description" content={description} />
    <link rel="manifest" href="/manifest.json" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#eef0ee" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121418" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="WASudoku" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="WASudoku" />
    <meta property="og:url" content={site} />
    <meta property="og:title" content="WASudoku" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={preview} />
    <meta property="og:image:secure_url" content={preview} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="2292" />
    <meta property="og:image:height" content="1200" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={site} />
    <meta property="twitter:title" content="WASudoku" />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={preview} />
  </head>
  <body>
    <Sprite />
    <slot />
  </body>
</html>
