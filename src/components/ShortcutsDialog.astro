import { MODIFIER, SHORTCUT_SECTIONS, SHORTCUTS_HINT, SHORTCUTS_TEXT } from '../core/text/shortcuts'
import CloseButton from './CloseButton.astro'
---

{/* A static list, built from the keymap's tables. The page swaps each data-modifier cap for Cmd on Apple. */}
<dialog
  id="shortcuts-dialog"
  class="dlg shortcuts sm:max-w-lg lg:max-w-4xl"
  closedby="any"
  aria-labelledby="shortcuts-title"
  aria-describedby="shortcuts-hint"
>
  <form method="dialog" class="contents">
    <h2 id="shortcuts-title" class="voice-ink text-ink pr-6 text-xl leading-tight tracking-tight">
      {SHORTCUTS_TEXT.title}
    </h2>
    {/* Focusable, so the list scrolls by keyboard on a short screen in every engine. */}
    <div class="shortcuts-body" tabindex="0" role="region" aria-labelledby="shortcuts-title">
      {
        SHORTCUT_SECTIONS.map((section) => (
          <table class="shortcuts-table">
            <caption class="voice-mono text-muted-foreground text-xs tracking-wider uppercase">
              {section.title}
            </caption>
            <thead class="sr-only">
              <tr>
                <th scope="col">{SHORTCUTS_TEXT.keys}</th>
                <th scope="col">{SHORTCUTS_TEXT.action}</th>
              </tr>
            </thead>
            <tbody>
              {section.rows.map((row) => (
                <tr>
                  <th scope="row">
                    {row.chords.map((chord, index) => (
                      <>
                        {index > 0 && <span class="shortcuts-or">{SHORTCUTS_TEXT.or}</span>}
                        <kbd class="shortcuts-chord">
                          {chord.map((key, at) => (
                            <>
                              {at > 0 && <span>{SHORTCUTS_TEXT.join}</span>}
                              <kbd data-modifier={key === MODIFIER ? '' : undefined}>{key}</kbd>
                            </>
                          ))}
                        </kbd>
                      </>
                    ))}
                  </th>
                  <td>{row.action}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ))
      }
    </div>
    <p id="shortcuts-hint" class="text-muted-foreground text-sm">{SHORTCUTS_HINT}</p>
    <CloseButton autofocus />
  </form>
</dialog>
