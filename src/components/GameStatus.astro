import { PAUSE_LABELS } from '../core/text/labels'
import Button from './Button.astro'
import Icon from './Icon.astro'
import { isMistakeLimit, mistakesText, type StatusView, statusBar } from './view'

interface Props {
  status?: StatusView | undefined
}

/** Shown in play and after a win. Without a status it renders hidden, ready for script to fill. */
const bar = statusBar(Astro.props.status)
const status = bar.view
---

<div
  id="game-status"
  hidden={bar.hidden}
  class="voice-mono text-muted-foreground bg-paper flex min-h-10 w-full items-center justify-between rounded-md px-3 text-sm tabular-nums"
>
  <div class="flex items-center gap-3">
    <span class="text-foreground" data-status="difficulty">{status.difficulty}</span>
    <span class="flex items-center gap-1.5">
      <span>Mistakes:</span>
      <span
        data-status="mistakes"
        class:list={[isMistakeLimit(status.mistakes) && 'text-error font-bold']}
        >{mistakesText(status.mistakes)}</span
      >
    </span>
  </div>
  <div class="flex items-center gap-2">
    <span class="text-ink font-bold" data-status="solved" hidden={!status.solved}>Solved</span>
    <span class="text-foreground" data-status="time">{status.time}</span>
    <Button
      variant="ghost"
      size="icon-lg"
      class="-mr-3"
      id="pause-button"
      aria-label={PAUSE_LABELS.pause}
      title={PAUSE_LABELS.pause}
      hidden={status.solved === true}
    >
      <Icon name="pause" />
    </Button>
  </div>
</div>
