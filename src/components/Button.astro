import type { HTMLAttributes } from 'astro/types'

import type { Size, Variant } from './controls'

type Props = HTMLAttributes<'button'> & {
  variant: Variant
  size: Size
}

const { variant, size, class: className, type = 'button', ...rest } = Astro.props
---

<button type={type} class:list={['btn', className]} data-variant={variant} data-size={size} {...rest}
  ><slot /></button
>
