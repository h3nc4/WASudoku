import BoardCells from './BoardCells.astro'
import Button from './Button.astro'
import Icon from './Icon.astro'
import { boardRows, type CellView } from './view'

interface Props {
  cells: readonly CellView[]
}

const rows = boardRows(Astro.props.cells)
---

{/* One tab stop for the grid. Arrow keys move inside it, and each cell's label states its contents. */}
{/* A space parts each note glyph, so the visible digits read as words inside the cell's name. */}
<div class="relative">
  <div role="grid" id="board" class="board" aria-label="Sudoku board">
    <BoardCells rows={rows} />
  </div>
  <div class="pause-overlay" id="pause-overlay" hidden>
    <p class="text-ink voice-ink text-2xl">Paused</p>
    <Button variant="primary" size="md" id="resume-button">
      <Icon name="play" class="mr-2 size-4" />
      Resume
    </Button>
  </div>
</div>
