import type { Example } from '../pages-data/examples'
import { figureRows } from '../pages-data/figure'
import BoardCells from './BoardCells.astro'

interface Props {
  example: Example
}

const { example } = Astro.props
const rows = figureRows(example.cells)
---

{/* The drawing is hidden from assistive technology. The caption and the list say what it shows. */}
<figure class="figure">
  <div class="board" aria-hidden="true">
    <BoardCells rows={rows} />
  </div>
  <figcaption>
    <p>{example.caption}</p>
    <ul>
      {example.facts.map((fact) => <li>{fact}</li>)}
    </ul>
  </figcaption>
</figure>
