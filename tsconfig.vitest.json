{
  "extends": "./tsconfig.app.json",
  "include": ["src", "e2e/saves.ts"],
  "exclude": [
    "src/pages",
    "src/layouts",
    "src/components-next/**/*.test.ts",
    "src/components-next/astro.d.ts",
    "src/preview",
    "src/pages-data",
    "src/ui/**/*.browser.test.ts",
    "src/test/built-page.ts",
    "src/test/built-page.setup.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"]
  }
}
